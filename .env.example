# cp .env.example .env   (safe defaults: `docker compose up` works with zero edits)

# --- Database ---
DATABASE_URL=postgresql://waypoint:waypoint@db:5432/waypoint?schema=public
# Prisma migrations need a direct (non-pooled) connection. Locally it is the same URL.
# On Neon: DATABASE_URL = pooled string, DIRECT_URL = direct string.
DIRECT_URL=postgresql://waypoint:waypoint@db:5432/waypoint?schema=public
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
TZ=Asia/Colombo
# CHANGE in any deployed environment:  openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-dev-only-change-me
SESSION_COOKIE_SECURE=false

# --- Demo ---
DEMO_DATE=2026-10-05
SEED_ON_BOOT=true
SEED_PASSWORD=Waypoint#2026

# --- Uploads: proof-of-delivery photos and signatures are stored IN Postgres, never on disk ---
PHOTO_MAX_KB=250
